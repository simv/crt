{
  "name": "claude-review-tool",
  "version": "0.5.0",
  "description": "Claude Review Tool (CRT): annotate your local site in the browser, talk to Claude in-page, get a self-contained task file in your repo.",
  "license": "MIT",
  "homepage": "https://github.com/simv/crt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simv/crt.git",
    "directory": "packages/server"
  },
  "bugs": "https://github.com/simv/crt/issues",
  "keywords": [
    "claude",
    "claude-code",
    "review",
    "annotate",
    "feedback",
    "proxy",
    "overlay",
    "devtools",
    "vite-plugin",
    "nextjs"
  ],
  "type": "module",
  "bin": {
    "crt": "dist/cli.js"
  },
  "exports": {
    "./loader": {
      "types": "./dist/integrations/loader.d.ts",
      "production": "./dist/integrations/noop-loader.js",
      "default": "./dist/integrations/loader.js"
    },
    "./react": {
      "types": "./dist/integrations/react.d.ts",
      "production": "./dist/integrations/noop-react.js",
      "default": "./dist/integrations/react.js"
    },
    "./vite": {
      "types": "./dist/integrations/vite.d.ts",
      "default": "./dist/integrations/vite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-intake.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch",
    "e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.270",
    "zod": "^4.0.0"
  }
}
