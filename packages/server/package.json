{
  "name": "claude-review-tool",
  "version": "0.1.0",
  "description": "Claude Review Tool (CRT): annotate your local site in the browser, talk to Claude in-page, get a self-contained task file in your repo.",
  "license": "MIT",
  "homepage": "https://github.com/simv/crt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simv/crt.git",
    "directory": "packages/server"
  },
  "bugs": "https://github.com/simv/crt/issues",
  "keywords": ["claude", "claude-code", "review", "annotate", "feedback", "proxy", "overlay"],
  "type": "module",
  "bin": {
    "crt": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-intake.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.270",
    "zod": "^4.0.0"
  }
}
